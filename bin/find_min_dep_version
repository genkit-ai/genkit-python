"""Find (and optionally apply) the lowest passing version of a dependency.

Use when the `tests-minimum-deps` CI job fails on a PR: it binary-searches PyPI
releases between the declared floor in `packages/<package>/pyproject.toml` and
the version in `uv.lock`, running `packages/<package>/tests` in an isolated env
at each step.

    bin/find_min_dep_version genkit-openai openai --apply
"""

from __future__ import annotations

import argparse
import json
import os
import re
import ssl
import subprocess
import sys
import tomllib
import urllib.request
from pathlib import Path

import certifi
from packaging.version import InvalidVersion, Version

PY_DIR = Path(__file__).resolve().parents[1]

# Released together with exact `==` pins on each other; test them at the same version.
LOCKSTEP = {
    'opentelemetry-api': ('opentelemetry-sdk',),
    'opentelemetry-sdk': ('opentelemetry-api',),
}


def _toml_path(package: str) -> Path:
    path = PY_DIR / 'packages' / package / 'pyproject.toml'
    if not path.exists():
        available = sorted(p.parent.name for p in (PY_DIR / 'packages').glob('*/pyproject.toml'))
        sys.exit(f"unknown package '{package}'. Available: {', '.join(available)}")
    return path


def _all_specs(data: dict) -> list[str]:
    proj = data.get('project', {})
    specs = list(proj.get('dependencies', []))
    for extra_specs in proj.get('optional-dependencies', {}).values():
        specs.extend(extra_specs)
    return specs


def _declared_floor(package: str, dep: str) -> Version:
    data = tomllib.loads(_toml_path(package).read_text())
    found_deps: list[str] = []
    for spec in _all_specs(data):
        m = re.match(r'([A-Za-z0-9._-]+)(?:\[[^\]]*\])?\s*([^;]*)', spec)
        if not m:
            continue
        name = m.group(1).lower().replace('_', '-')
        found_deps.append(name)
        if name == dep:
            floor = re.search(r'>=\s*([^,\s]+)', m.group(2))
            if floor:
                return Version(floor.group(1))
    sys.exit(f"{package} has no '>=' floor for '{dep}'. Declared deps: {', '.join(sorted(set(found_deps)))}")


def _apply_floor(package: str, dep: str, new_floor: Version) -> None:
    path = _toml_path(package)
    original = path.read_text()
    pattern = re.compile(
        rf'("(?P<name>[A-Za-z0-9._-]+)(?P<extras>\[[^\]]*\])?\s*>=\s*)(?P<old>[^,",;\s]+)',
    )

    def _replace(match: re.Match[str]) -> str:
        if match.group('name').lower().replace('_', '-') != dep:
            return match.group(0)
        return f'{match.group(1)}{new_floor}'

    updated = pattern.sub(_replace, original)
    if updated == original:
        sys.exit(f'failed to rewrite {dep} floor in {path}')
    path.write_text(updated)
    subprocess.run(['uv', 'lock'], cwd=PY_DIR, check=True)


def _locked_versions(dep: str) -> list[Version]:
    text = (PY_DIR / 'uv.lock').read_text()
    return [Version(v) for v in re.findall(rf'name = "{re.escape(dep)}"\nversion = "([^"]+)"', text)]


def _releases(dep: str) -> list[Version]:
    ctx = ssl.create_default_context(cafile=certifi.where())
    with urllib.request.urlopen(f'https://pypi.org/pypi/{dep}/json', timeout=30, context=ctx) as r:
        data = json.load(r)
    out = []
    for v, files in data['releases'].items():
        try:
            pv = Version(v)
        except InvalidVersion:
            continue
        if files and not pv.is_devrelease and not any(f.get('yanked') for f in files):
            out.append(pv)
    return sorted(out)


def _passes(package: str, dep: str, version: Version, python: str | None) -> bool:
    cmd = ['uv', 'run', '-q', '--isolated', '--all-extras', '--directory', str(PY_DIR), '--package', package]
    if python:
        cmd += ['--python', python]
    pins = [f'{d}=={version}' for d in (dep, *LOCKSTEP.get(dep, ()))]
    for extra in (*pins, 'pytest', 'pytest-asyncio', 'pytest-mock', 'psutil'):
        cmd += ['--with', extra]
    cmd += ['pytest', '-q', '-p', 'no:cacheprovider', f'packages/{package}/tests']
    env = {**os.environ, 'PYTEST_ADDOPTS': '-o addopts='}
    proc = subprocess.run(cmd, capture_output=True, text=True, env=env, check=False)
    last = (proc.stdout.strip().splitlines() or proc.stderr.strip().splitlines() or ['?'])[-1]
    print(f'{dep}=={version}: {"PASS" if proc.returncode == 0 else "FAIL"} ({last[:100]})', flush=True)
    return proc.returncode == 0


def main() -> int:
    """Run the floor search, print actionable next steps, or rewrite pyproject.toml + uv.lock with --apply."""
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument('package', help='workspace package dir under packages/, e.g. genkit-openai')
    parser.add_argument('dep', help='third-party dependency name, e.g. openai')
    parser.add_argument('--python', help='interpreter for test envs (default: uv picks; CI uses 3.10)')
    parser.add_argument(
        '--apply',
        action='store_true',
        help='rewrite packages/<package>/pyproject.toml to the found floor and update uv.lock',
    )
    args = parser.parse_args()
    dep = args.dep.lower().replace('_', '-')

    floor = _declared_floor(args.package, dep)
    locked = _locked_versions(dep)
    if not locked:
        sys.exit(f'{dep} is not in uv.lock')
    ceiling = max(locked)
    allow_pre = floor.is_prerelease or ceiling.is_prerelease
    cands = [v for v in _releases(dep) if floor <= v <= ceiling and (allow_pre or not v.is_prerelease)]
    if not cands:
        sys.exit(f'no releases of {dep} between {floor} and {ceiling}')

    if not _passes(args.package, dep, cands[-1], args.python):
        print(
            f'\nERROR: {dep}=={cands[-1]} (current uv.lock version) also fails.\n'
            f'Fix the broken test on locked deps first (`uv run pytest packages/{args.package}/tests`), '
            'then re-run bin/find_min_dep_version.',
        )
        return 1

    lo, hi = 0, len(cands) - 1
    while lo < hi:
        mid = (lo + hi) // 2
        if _passes(args.package, dep, cands[mid], args.python):
            hi = mid
        else:
            lo = mid + 1

    best = cands[lo]
    toml_rel = f'packages/{args.package}/pyproject.toml'
    print(f'\nRESULT: {args.package} requires {dep}>={best} (currently declared >={floor})')

    if best == floor:
        print(
            f'Floor {dep}>={floor} already passes in isolation. If `tests-minimum-deps` failed in CI, '
            f'another direct dependency of {args.package} (or core `genkit`) is the culprit—check '
            'the downgraded package list in the CI log and run bin/find_min_dep_version on that dep.',
        )
        return 0

    if args.apply:
        _apply_floor(args.package, dep, best)
        print(
            f'APPLIED: updated {toml_rel} to {dep}>={best} and refreshed uv.lock.\n'
            'Next: run `python3 scripts/check_consistency.py` and commit both files.',
        )
    else:
        print(
            f'\nNext steps to turn `tests-minimum-deps` green:\n'
            f'  1. Bump `{dep}>={floor}` -> `{dep}>={best}` in {toml_rel} (keep any `<N` cap intact),\n'
            f'     or re-run with `--apply`:\n'
            f'       bin/find_min_dep_version {args.package} {dep} --apply\n'
            f'  2. Refresh the lockfile (if edited manually): uv lock\n'
            f'  3. Verify consistency: python3 scripts/check_consistency.py\n'
            f'  4. Commit {toml_rel} and uv.lock in this PR.',
        )
    return 0


if __name__ == '__main__':
    sys.exit(main())
